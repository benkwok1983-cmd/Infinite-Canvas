# Infinite-Canvas 本地密钥配置模板
#
# 用法：把本文件复制成同目录下的 .env，再把等号后面填上你的真实密钥。
#
#     copy API\.env.example API\.env        # Windows CMD
#     cp API/.env.example API/.env          # Git Bash / macOS / Linux
#
# API/.env 已被 .gitignore 排除，不会进版本库，可以放心存放真实密钥。
# 本模板（.env.example）不含任何真实密钥，会正常进版本库。
#
# 格式：每行一个 KEY=VALUE，等号两侧不要加空格，值不要带引号（解析器会自动去除）。
# 留空或整行注释掉即视为「未配置」，程序会自动跳过。

# ── 魔搭 ModelScope ────────────────────────────────────────────
# 从 https://modelscope.cn/my/myaccesstoken 获取
MODELSCOPE_API_KEY=
# 可选：手动指定聊天模型清单，留空则用内置默认列表
MODELSCOPE_CHAT_MODELS=

# ── OpenAI 兼容供应商 ──────────────────────────────────────────
# 在「API 设置」页添加自定义供应商时使用；
# provider id 为 openai 时默认读这个变量。
API_PROVIDER_OPENAI_KEY=

# ── 火山方舟（Ark）─────────────────────────────────────────────
ARK_API_KEY=

# ── RunningHub ─────────────────────────────────────────────────
RUNNINGHUB_API_KEY=
# 钱包 Key：用于扣费类接口，与上面的 API Key 是两回事
RUNNINGHUB_WALLET_API_KEY=

# ── 其他第三方中转 ────────────────────────────────────────────
COMFLY_API_KEY=

# ── 自定义供应商 ──────────────────────────────────────────────
# 规则：API_PROVIDER_<供应商ID大写下划线化>_KEY
# 例：供应商 id 为 "my-proxy" → API_PROVIDER_MY_PROXY_KEY

# ── 火山引擎（账号级凭据，权限最高，谨慎填写）──────────────────
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=